from datetime import datetime
import uuid

from ..extensions import db


class ServiceArea(db.Model):
    __tablename__ = "service_areas"

    id = db.Column(
        db.String(36),
        primary_key=True,
        default=lambda: str(uuid.uuid4()),
    )

    company_id = db.Column(
        db.String(36),
        db.ForeignKey("companies.id"),
        nullable=False,
        index=True,
    )

    location_id = db.Column(
        db.String(36),
        db.ForeignKey("locations.id"),
        nullable=True,
        index=True,
    )

    area = db.Column(
        db.String(255),
        nullable=False,
    )

    zip_code = db.Column(
        db.String(20),
        nullable=True,
    )

    city = db.Column(
        db.String(100),
        nullable=True,
    )

    state = db.Column(
        db.String(100),
        nullable=True,
    )

    status = db.Column(
        db.String(50),
        nullable=False,
        default="active",
    )

    created_at = db.Column(
        db.DateTime,
        nullable=False,
        default=datetime.utcnow,
    )

    updated_at = db.Column(
        db.DateTime,
        nullable=False,
        default=datetime.utcnow,
        onupdate=datetime.utcnow,
    )

    def __repr__(self):
        return f"<ServiceArea {self.area}>"